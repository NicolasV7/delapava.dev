{
  "permissions": {
    "allow": [
      "Bash(node:*)", "Bash(npm:*)", "Bash(npx astro:*)", "Bash(git status*)", "Bash(git log*)",
      "Bash(git diff*)", "Bash(git add*)", "Bash(git commit*)", "Agent"
    ],
    "deny": ["Read(./.env*)"]
  },
  "hooks": {
    "Stop": [{ "hooks": [{ "type": "command", "command": "bash scripts/check.sh", "timeout": 600 }] }]
  }
}
